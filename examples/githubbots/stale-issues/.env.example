# Copy to .env and fill in. Loaded automatically for local runs.
#
# None of this is used in GitHub Actions: the workflow supplies the equivalent
# values from secrets, repository variables and the run context.

# GitHub token with `issues: write` on the target repository.
GITHUB_TOKEN=your_github_token_here

# Model credentials: either a Gemini API key...
GEMINI_API_KEY=your_api_key_here
# ...or use Vertex AI via Application Default Credentials instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_project
# GOOGLE_CLOUD_LOCATION=global

# Target repository to audit (required; no default).
OWNER=target_repository_owner
REPO=target_repository_name

# The login the bot posts under, so it recognizes its own comments. Leave it
# empty for a local run and it is resolved from the API; in GitHub Actions it
# must be set, because GET /user is refused for an installation token.
BOT_LOGIN=

# Maintainer GitHub logins (comma-separated). REQUIRED: the default GITHUB_TOKEN
# cannot list collaborators, so the maintainer set must be provided explicitly.
# With an empty list nothing is ever marked stale.
MAINTAINERS=octocat,hubot

# Optional overrides.
LLM_MODEL_NAME=gemini-flash-latest

# 14 days waiting on the author -> warn.
STALE_HOURS_THRESHOLD=336
# 7 more days stale -> close.
CLOSE_HOURS_AFTER_STALE_THRESHOLD=168

STALE_LABEL_NAME=stale
REQUEST_CLARIFICATION_LABEL=request clarification
CONCURRENCY_LIMIT=3

# Ceilings on a single run. MAX_ISSUES bounds how much work a sweep does.
# MAX_DESTRUCTIVE_ACTIONS bounds how much harm it can do: it counts only the
# two actions that damage an issue (marking stale, closing), so a run that has
# hit it can still remove a label or alert a maintainer. Hitting either is
# reported in the exit code, because a run that stopped short of what it judged
# necessary needs a human to look at it.
MAX_ISSUES=100
MAX_DESTRUCTIVE_ACTIONS=20

# Bounds a single issue's audit.
ISSUE_TIMEOUT=5m
# Bounds the whole run. In Actions keep it below the job's timeout-minutes, so
# an overrun is reported here rather than the job being killed mid-sweep.
RUN_BUDGET=30m
