# Copy to .env and fill in. Loaded automatically for local runs.

# GitHub token with `issues: write` on the TARGET repository.
GITHUB_TOKEN=your_github_token_here

# Model credentials: either a Gemini API key...
GEMINI_API_KEY=your_api_key_here
# ...or use Vertex AI via Application Default Credentials instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_project
# GOOGLE_CLOUD_LOCATION=global

# Source repository whose releases are diffed (required; no default).
OWNER=google
REPO=adk-go

# Repository the issue is filed in. Defaults to the source repository, which is
# the only one the built-in Actions GITHUB_TOKEN can write to. Pointing these at
# another repository needs a cross-repo token; see README.md.
# TARGET_OWNER=google
# TARGET_REPO=adk-docs

# Release range. Empty END_TAG means the most recent release; empty START_TAG
# means the release published before it.
START_TAG=
END_TAG=

# Optional overrides.
LLM_MODEL_NAME=gemini-flash-latest
MAX_FILES=60
MAX_PATCH_BYTES=8000
MAX_COMMITS=100
FILES_PER_GROUP=5
MAX_FINDINGS_PER_GROUP=10
RUN_BUDGET=15m
GROUP_TIMEOUT=4m
DRY_RUN=true
