# Copy to .env and fill in. Loaded automatically for local runs.

# GitHub token with `issues: write` on the target repository. Setting an issue
# type or label also needs push access; without it GitHub silently drops the
# change and the bot fails the run rather than reporting a success.
GITHUB_TOKEN=your_github_token_here

# Model credentials: either a Gemini API key (GOOGLE_API_KEY also works)...
GEMINI_API_KEY=your_api_key_here
# ...or use Vertex AI via Application Default Credentials instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_project
# GOOGLE_CLOUD_LOCATION=global

# Target repository to triage (required; no default). In GitHub Actions the
# workflow derives both from github.repository instead.
OWNER=target_repository_owner
REPO=target_repository_name

# Optional overrides. A value that cannot be parsed is a startup error, not a
# silent fall back to the default.
# Log intended actions without mutating anything (same as the -dry-run flag).
# On by default in this template: a first local run against a real repository
# should be a rehearsal. Flip it once you have seen what the bot would do.
DRY_RUN=true
LLM_MODEL_NAME=gemini-flash-latest
ALLOWED_LABELS=bug,enhancement,documentation,question
ISSUE_COUNT=3
FRESHNESS_WINDOW_DAYS=0
ISSUE_TIMEOUT=5m
# Bounds the WHOLE run, model construction included, so N issues cannot
# multiply into N x ISSUE_TIMEOUT and overrun the workflow job timeout (which
# kills the process silently). Must fit ISSUE_COUNT x ISSUE_TIMEOUT plus a
# minute for choosing the work set, or startup fails.
SWEEP_TIMEOUT=20m
