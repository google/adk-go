# Copy to .env and fill in. Loaded automatically for local runs.

# GitHub token with `pull-requests: write` on the target repository.
GITHUB_TOKEN=your_github_token_here

# Model credentials: either a Gemini API key...
GEMINI_API_KEY=your_api_key_here
# ...or use Vertex AI via Application Default Credentials instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_project
# GOOGLE_CLOUD_LOCATION=global

# Target repository (required; no default, so a typo cannot silently point the
# bot at some other repository).
OWNER=target_repository_owner
REPO=target_repository_name

# Required. component=login pairs, comma separated. This is the COMPLETE set of
# logins the bot may ever assign: the model picks a component, and only a key of
# this map resolves to a person. Component names are lowercased; logins must be
# valid GitHub logins.
OWNER_MAP=core=alice,tools=bob,documentation=carol

# Optional overrides.
LLM_MODEL_NAME=gemini-flash-latest
# Triage one pull request. Leave empty for a batch over unassigned ones.
PULL_REQUEST_NUMBER=
# Batch size when PULL_REQUEST_NUMBER is empty (1-100).
PR_COUNT=10
# Set to false to disable the "ask the author for more context" comment
# entirely; the tool is then not registered at all. It is off in batch mode
# (empty PULL_REQUEST_NUMBER) whatever this says.
REQUEST_CONTEXT=true

# The login this bot posts under, so it can recognize its own past comment. In
# GitHub Actions this must be set: the built-in token cannot read GET /user.
BOT_LOGIN=github-actions[bot]
# How many changed-file paths are shown to the model (1-100; GitHub's GraphQL
# schema rejects a page size above 100).
MAX_FILES=50
CONCURRENCY_LIMIT=3
PR_TIMEOUT=5m
# Keep below the workflow's timeout-minutes so an overrun is reported here.
RUN_BUDGET=10m
# Log intended actions without performing them.
DRY_RUN=false
