# Copy to .env and fill in. Loaded automatically for local runs.

# GitHub token with `issues: write` on the target repository.
GITHUB_TOKEN=your_github_token_here

# Model credentials: either a Gemini API key...
GEMINI_API_KEY=your_api_key_here
# ...or use Vertex AI via Application Default Credentials instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_project
# GOOGLE_CLOUD_LOCATION=global

# The login this bot posts as. Leave empty for a personal access token, whose
# identity the bot can resolve itself. Under GitHub Actions it must be set:
# the built-in GITHUB_TOKEN cannot call GET /user.
BOT_LOGIN=

# Target repository to moderate (required; no default).
OWNER=target_repository_owner
REPO=target_repository_name

# Optional overrides.
LLM_MODEL_NAME=gemini-flash-latest
SPAM_LABEL_NAME=spam
# Comma-separated logins whose comments are trusted and never reviewed for spam.
MAINTAINERS=
ISSUE_COUNT=3
CONCURRENCY_LIMIT=3
FRESHNESS_WINDOW_DAYS=0
ISSUE_TIMEOUT=5m
# Bounds the whole run. The workflow's job timeout sits above this so an
# overrun is reported by the bot rather than the runner killing the job.
RUN_TIMEOUT=15m
